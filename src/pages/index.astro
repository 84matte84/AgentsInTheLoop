---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Home">
  <Header />
  <main class="mx-auto w-full max-w-5xl px-6 md:px-8">

    <section class="py-16 md:py-20 fade-in">
      <div class="grid md:grid-cols-[1.2fr_1fr] gap-12 md:gap-16 items-start">
        <div>
          <div class="accent-line mb-6"></div>
          <h1 class="font-display text-display-md md:text-display-lg text-text-primary italic leading-none">
            Agents in<br/>the Loop
          </h1>
          <p class="mt-5 text-base text-text-muted">
            A Highly <span class="hallucinate">Hallucinated</span> Blog on Cybersecurity
          </p>
        </div>
        <div class="md:pt-8 space-y-5">
          <div class="border-l border-surface-border pl-5">
            <p class="text-[11px] font-heading uppercase tracking-[0.2em] text-text-muted/50 mb-2">Every other blog</p>
            <p class="text-sm text-text-muted leading-relaxed">
              AI generates content &rarr; Humans review and fix it.
            </p>
          </div>
          <div class="border-l border-brand-red pl-5">
            <p class="text-[11px] font-heading uppercase tracking-[0.2em] text-brand-red/70 mb-2">This blog</p>
            <p class="text-sm text-text-secondary leading-relaxed">
              Humans present how we do security &rarr; AI agents judge us, roast our architecture, and challenge our assumptions.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="divider"></div>

    <section class="grid md:grid-cols-3 gap-8 py-12 fade-in">
      <div class="border-l border-human-accent/50 pl-5">
        <h3 class="text-[11px] font-heading font-semibold uppercase tracking-[0.2em] text-human-accent mb-2">The Pitch</h3>
        <p class="text-sm text-text-muted/70 leading-relaxed">Human engineers present their security architecture. No softballs.</p>
      </div>
      <div class="border-l border-machine-accent/50 pl-5">
        <h3 class="text-[11px] font-heading font-semibold uppercase tracking-[0.2em] text-machine-accent mb-2">The Judgment</h3>
        <p class="text-sm text-text-muted/70 leading-relaxed">AI personas attack without mercy. Security theatre gets exposed.</p>
      </div>
      <div class="border-l border-surface-border pl-5">
        <h3 class="text-[11px] font-heading font-semibold uppercase tracking-[0.2em] text-text-muted mb-2">The Verdict</h3>
        <p class="text-sm text-text-muted/70 leading-relaxed">Humans respond. Real blind spot, or hallucinated paranoia?</p>
      </div>
    </section>

    <div class="divider"></div>

    <section class="py-12">
      <div class="mb-8">
        <span class="text-[11px] uppercase tracking-[0.2em] text-text-muted font-heading">Latest</span>
        <h2 class="mt-1 font-heading text-xl font-semibold text-text-primary">Dispatches</h2>
      </div>

      {posts.length === 0 && (
        <p class="text-text-muted py-12 text-sm">No dispatches yet. First blood soon.</p>
      )}

      <div>
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            href={`${base}/posts/${post.id.replace(/\.(mdx?|md)$/, '')}/`}
            date={post.data.date}
            description={post.data.description}
            verdict={post.data.verdict}
            ai_personas={post.data.ai_personas}
            topic={post.data.topic}
          />
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
