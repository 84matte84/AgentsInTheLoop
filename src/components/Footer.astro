---
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="mt-auto border-t border-surface-border/50 py-12 md:py-16">
  <div class="mx-auto max-w-5xl px-6 md:px-8">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div>
        <span class="font-display text-base italic text-text-primary">Agents in the Loop</span>
        <p class="mt-2 text-xs text-text-muted/50 max-w-xs leading-relaxed">
          Human ideas. Machine judgment. Questionable conclusions.
        </p>
      </div>
      <div class="text-[11px] uppercase tracking-[0.15em] text-text-muted/40 font-heading">
        &copy; {year}
      </div>
    </div>
  </div>
</footer>
