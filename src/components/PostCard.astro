---
export interface Props {
  title: string;
  href: string;
  date: Date;
  description: string;
  verdict: 'won' | 'lost' | 'mixed';
  ai_personas: string[];
  topic: string;
}

const { title, href, date, description, verdict, ai_personas, topic } = Astro.props;

const verdictConfig = {
  won: { label: 'Human Wins', class: 'text-verdict-won' },
  lost: { label: 'AI Wins', class: 'text-verdict-lost' },
  mixed: { label: 'Split', class: 'text-verdict-mixed' },
};

const config = verdictConfig[verdict];

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={href} class="post-card group block">
  <div class="flex items-start justify-between gap-8">
    <div class="flex-1 min-w-0">
      <h3 class="font-heading text-lg font-semibold text-text-primary group-hover:text-brand-red transition-colors duration-300 md:text-xl">
        {title}
      </h3>
      <p class="mt-2 text-sm text-text-muted leading-relaxed line-clamp-2">{description}</p>
      <div class="mt-4 flex items-center gap-4 text-[11px] uppercase tracking-[0.15em] text-text-muted/60">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <span class="text-surface-border">|</span>
        <span>{topic}</span>
        <span class="text-surface-border">|</span>
        <span class="font-mono normal-case tracking-normal text-text-muted/50">
          vs {ai_personas.join(', ')}
        </span>
      </div>
    </div>
    <div class="hidden sm:flex flex-col items-end gap-2 pt-1">
      <span class={`text-[11px] font-heading font-semibold uppercase tracking-[0.15em] ${config.class}`}>
        {config.label}
      </span>
    </div>
  </div>
</a>
