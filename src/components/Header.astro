---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navLinks = [
  { href: `${base}/`, label: 'Index' },
  { href: `${base}/about/`, label: 'About' },
];
---

<header class="border-b border-surface-border/50 bg-surface/90 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5 md:px-8">
    <a href={`${base}/`} class="group flex items-center gap-3">
      <span class="font-display text-lg font-bold text-text-primary tracking-tight italic">
        Agents in the Loop
      </span>
    </a>
    <div class="flex items-center gap-8">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="text-xs uppercase tracking-[0.15em] text-text-muted transition-colors hover:text-text-primary font-heading"
        >
          {label}
        </a>
      ))}
      <a
        href={`${base}/rss.xml`}
        class="text-text-muted transition-colors hover:text-brand-red"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <circle cx="6.18" cy="17.82" r="2.18"/>
          <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/>
        </svg>
      </a>
    </div>
  </nav>
</header>
