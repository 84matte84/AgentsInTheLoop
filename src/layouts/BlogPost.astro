---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  date: Date;
  ai_personas: string[];
  topic: string;
  verdict: 'won' | 'lost' | 'mixed';
  description: string;
}

const { title, date, ai_personas, topic, verdict, description } = Astro.props;

const verdictConfig = {
  won: { label: 'Human Wins', class: 'text-verdict-won border-verdict-won/30' },
  lost: { label: 'AI Wins', class: 'text-verdict-lost border-verdict-lost/30' },
  mixed: { label: 'Split Decision', class: 'text-verdict-mixed border-verdict-mixed/30' },
};

const config = verdictConfig[verdict];

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description}>
  <Header />
  <main class="mx-auto w-full max-w-3xl px-6 md:px-8">
    <article>
      <header class="py-16 md:py-24 fade-in">
        <div class="flex items-center gap-4 text-[11px] uppercase tracking-[0.2em] text-text-muted font-heading">
          <span>{topic}</span>
          <span class="text-surface-border">/</span>
          <span class={config.class}>{config.label}</span>
        </div>
        <h1 class="mt-6 font-display text-display-md md:text-display-lg text-text-primary italic leading-tight">
          {title}
        </h1>
        <div class="mt-8 text-sm text-text-muted">
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
        <div class="mt-3 font-mono text-xs text-text-muted/50">
          Adversary: {ai_personas.join(' / ')}
        </div>
      </header>

      <div class="divider"></div>

      <div class="space-y-12 py-12 prose prose-lg prose-invert max-w-none
        prose-headings:font-heading prose-headings:font-semibold prose-headings:text-text-primary
        prose-p:text-text-secondary prose-p:leading-[1.8]
        prose-a:text-brand-red prose-a:no-underline hover:prose-a:underline
        prose-strong:text-text-primary prose-strong:font-semibold
        prose-code:text-brand-red/80 prose-code:before:content-none prose-code:after:content-none prose-code:font-normal
        prose-pre:bg-machine-bg prose-pre:border prose-pre:border-surface-border prose-pre:rounded-none
        prose-blockquote:border-l-brand-red prose-blockquote:text-text-muted prose-blockquote:not-italic">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</Base>
